<Window x:Class="SimuladorCompuertrtas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimuladorCompuertrtas.ViewModels"
        Title="LOGIC LAB — Simulador de Compuertas" Width="1280" Height="800" MinWidth="960" MinHeight="620"
        Background="#FF0A1321" Foreground="{StaticResource InkBrush}" KeyDown="Window_KeyDown">
    <Window.DataContext><vm:MainWindowViewModel /></Window.DataContext>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
        <Border Background="#FF0D1929" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0" /><TextBlock Text="LOGIC LAB" FontSize="21" FontWeight="Bold" /><TextBlock Text=" / laboratorio digital" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" Margin="12,0" /><Border Background="#FF142840" CornerRadius="10" Padding="9,4" Margin="12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Challenges.Progress.Rank}" FontSize="11" /><TextBlock Text="{Binding Challenges.Progress.Xp, StringFormat={}{0} XP}" FontSize="11" Foreground="{StaticResource AccentBrush}" /></StackPanel></Border></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton Content="LABORATORIO" IsChecked="{Binding IsLaboratoryMode}" GroupName="Mode" Margin="8" /><RadioButton Content="APRENDER" IsChecked="{Binding IsLearningMode}" GroupName="Mode" Margin="8" /><RadioButton Content="DESAFÍOS" IsChecked="{Binding IsChallengesMode}" GroupName="Mode" Margin="8" /></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Visibility="{Binding IsLaboratoryMode, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
            <Border Background="#FF0D1929" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="COMPONENTES" FontWeight="Bold" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,5,0,14" />
                    <TextBlock Text="ENTRADAS" Style="{StaticResource SectionLabel}" /><Button Content="◉  Switch" Command="{Binding Editor.AddComponentCommand}" CommandParameter="switch" ToolTip="Clic para agregar un interruptor; también puede arrastrarlo." PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="switch" />
                    <TextBlock Text="COMPUERTAS" Style="{StaticResource SectionLabel}" Margin="0,18,0,4" />
                    <Button Content="⌒  AND" Command="{Binding Editor.AddComponentCommand}" CommandParameter="and" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="and" /><Button Content="⌒  OR" Command="{Binding Editor.AddComponentCommand}" CommandParameter="or" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="or" /><Button Content="▷○ NOT" Command="{Binding Editor.AddComponentCommand}" CommandParameter="not" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="not" /><Button Content="⌒○ NAND" Command="{Binding Editor.AddComponentCommand}" CommandParameter="nand" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="nand" /><Button Content="⌒○ NOR" Command="{Binding Editor.AddComponentCommand}" CommandParameter="nor" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="nor" /><Button Content="⊕ XOR" Command="{Binding Editor.AddComponentCommand}" CommandParameter="xor" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="xor" /><Button Content="⊙ XNOR" Command="{Binding Editor.AddComponentCommand}" CommandParameter="xnor" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="xnor" />
                    <TextBlock Text="SALIDAS" Style="{StaticResource SectionLabel}" Margin="0,18,0,4" /><Button Content="●  LED" Command="{Binding Editor.AddComponentCommand}" CommandParameter="led" PreviewMouseMove="PaletteItem_PreviewMouseMove" Tag="led" />
                    <TextBlock Text="EJEMPLOS" Style="{StaticResource SectionLabel}" Margin="0,18,0,4" /><Button Content="Switch → LED" Click="Example_Click" Tag="wire" /><Button Content="AND" Click="Example_Click" Tag="and" /><Button Content="OR" Click="Example_Click" Tag="or" /><Button Content="NOT" Click="Example_Click" Tag="not" /><Button Content="XOR" Click="Example_Click" Tag="xor" />
                </StackPanel></ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Background="#FF0B1727">
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="#FF101E31" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,7"><DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="ÁREA DE CIRCUITO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Challenges.Active.Title, StringFormat={}· DESAFÍO: {0}}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="COMPROBAR" Style="{StaticResource PrimaryButton}" Command="{Binding Challenges.CheckCommand}" ToolTip="Validar todas las combinaciones del desafío" /><Button Content="REINICIAR" Style="{StaticResource ToolButton}" Command="{Binding Challenges.ResetCommand}" ToolTip="Reiniciar el desafío activo" /><Button Content="Nuevo" Style="{StaticResource ToolButton}" Command="{Binding Editor.ClearCircuitCommand}" ToolTip="Iniciar un circuito vacío" /><Button Content="Guardar" Style="{StaticResource ToolButton}" Click="SaveCircuit_Click" ToolTip="Guardar circuito como JSON" /><Button Content="Cargar" Style="{StaticResource ToolButton}" Click="LoadCircuit_Click" ToolTip="Cargar circuito JSON" /><Button Content="−" Style="{StaticResource ToolButton}" Command="{Binding Editor.ZoomOutCommand}" ToolTip="Alejar" /><Button Content="100%" Style="{StaticResource ToolButton}" Command="{Binding Editor.ResetZoomCommand}" ToolTip="Restablecer zoom" /><Button Content="+" Style="{StaticResource ToolButton}" Command="{Binding Editor.ZoomInCommand}" ToolTip="Acercar" /></StackPanel></DockPanel></Border>
                <Border Grid.Row="1" x:Name="Viewport" ClipToBounds="True" AllowDrop="True" Drop="EditorSurface_Drop" DragOver="EditorSurface_DragOver" MouseMove="EditorSurface_MouseMove" MouseLeftButtonUp="EditorSurface_MouseLeftButtonUp" MouseRightButtonDown="EditorSurface_MouseRightButtonDown" MouseRightButtonUp="EditorSurface_MouseRightButtonUp" Background="#FF0A1727">
                    <Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="Transparent"><GeometryDrawing.Pen><Pen Brush="#173A5878" Thickness="1" /></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="24,0" /><LineGeometry StartPoint="0,0" EndPoint="0,24" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Border.Background>
                    <Canvas x:Name="EditorSurface" Width="2400" Height="1600"><Canvas.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding Editor.Zoom}" ScaleY="{Binding Editor.Zoom}" /><TranslateTransform x:Name="PanTransform" /></TransformGroup></Canvas.RenderTransform>
                        <ItemsControl ItemsSource="{Binding Editor.Wires}" Panel.ZIndex="1"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF5B9CFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Cursor="Hand" MouseLeftButtonDown="Wire_MouseLeftButtonDown"><Line.Style><Style TargetType="Line"><Style.Triggers><DataTrigger Binding="{Binding State}" Value="High"><Setter Property="Stroke" Value="{StaticResource AccentBrush}" /><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF35D6BB" BlurRadius="8" ShadowDepth="0" /></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Stroke" Value="{StaticResource Danger}" /><Setter Property="StrokeThickness" Value="6" /></DataTrigger></Style.Triggers></Style></Line.Style></Line></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Line Panel.ZIndex="2" X1="{Binding Editor.WirePreviewX1}" Y1="{Binding Editor.WirePreviewY1}" X2="{Binding Editor.WirePreviewX2}" Y2="{Binding Editor.WirePreviewY2}" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeDashArray="5,4" Visibility="{Binding Editor.IsWiring, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Editor.Components}" Panel.ZIndex="3"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}" /><Setter Property="Canvas.Top" Value="{Binding Y}" /></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Width="144" Height="96" CornerRadius="10" BorderThickness="2" Padding="9" Background="#FF142840" BorderBrush="{StaticResource BorderBrush}" Cursor="SizeAll" MouseLeftButtonDown="Component_MouseLeftButtonDown" MouseMove="Component_MouseMove" MouseLeftButtonUp="Component_MouseLeftButtonUp"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF35D6BB" BlurRadius="16" ShadowDepth="0" Opacity=".55" /></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding OutputState}" Value="High"><Setter Property="Background" Value="#FF173D48" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <ItemsControl ItemsSource="{Binding Component.InputPorts}" VerticalAlignment="Center"><ItemsControl.ItemTemplate><DataTemplate><Button Width="16" Height="16" Padding="0" Margin="-8,4,0,4" ToolTip="Puerto de entrada" Background="#FF36516F" BorderBrush="{StaticResource AccentBlueBrush}" PreviewMouseLeftButtonUp="InputPort_MouseLeftButtonUp"><TextBlock Text="•" HorizontalAlignment="Center" /></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="28" Height="28" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="Transparent"><Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers><DataTrigger Binding="{Binding OutputState}" Value="High"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><Path Height="20" Stretch="Fill" Stroke="{StaticResource InkBrush}" StrokeThickness="2" Fill="Transparent" Margin="0,4,0,1"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 2,2 L 22,10 L 2,18 Z" /><Style.Triggers><DataTrigger Binding="{Binding IsGate}" Value="True"><Setter Property="Data" Value="M 1,1 L 14,1 Q 27,10 14,19 L 1,19 Z" /></DataTrigger><DataTrigger Binding="{Binding GateId}" Value="not"><Setter Property="Data" Value="M 1,1 L 20,10 L 1,19 Z" /></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" /><TextBlock Text="{Binding StateText}" FontSize="9" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" /></StackPanel>
                                    <Button Grid.Column="2" Width="18" Height="28" Padding="0" Background="#FF1D4B56" BorderBrush="{StaticResource AccentBrush}" ToolTip="Arrastra desde este puerto para crear una conexión" PreviewMouseLeftButtonDown="OutputPort_MouseLeftButtonDown"><TextBlock Text="›" FontSize="16" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Cambiar" Visibility="{Binding IsInput, Converter={StaticResource BoolToVisibility}}" Command="{Binding DataContext.Editor.ToggleInputCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="3,1" FontSize="9" ToolTip="Alternar estado del switch" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Canvas>
                </Border>
            </Grid>
            <Border Grid.Column="2" Background="#FF0D1929" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16"><StackPanel><TextBlock Text="INSPECTOR" FontWeight="Bold" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,5,0,14" /><Border Background="#FF142840" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="{Binding Editor.SelectionDescription}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="Selecciona un componente o cable para ver su estado. Usa Supr para eliminarlo." Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border><Button Content="Eliminar selección" Command="{Binding Editor.DeleteSelectionCommand}" Margin="0,14,0,0" ToolTip="Supr o Retroceso" /><TextBlock Text="CONSEJO" FontWeight="Bold" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,26,0,8" /><TextBlock Text="Arrastra desde la salida › hacia una entrada •. Pulsa el botón de Switch para cambiar entre 0 y 1." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" FontSize="12" /></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="1" Visibility="{Binding IsLearningMode, Converter={StaticResource BoolToVisibility}}" Margin="48,32"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="MODO APRENDER" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /><TextBlock Text="{Binding Learning.Gate.DisplayName}" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="{Binding Learning.Description}" FontSize="18" TextWrapping="Wrap" Margin="0,10,0,20" /><Border Background="#FF142840" Padding="22" CornerRadius="10"><StackPanel><TextBlock Text="MINI EXPERIMENTO" Foreground="{StaticResource MutedInkBrush}" FontWeight="Bold" /><TextBlock Text="{Binding Learning.ExperimentPrompt}" TextWrapping="Wrap" Margin="0,8" /><StackPanel Orientation="Horizontal"><Button Content="{Binding Learning.InputA}" Command="{Binding Learning.ToggleFirstInputCommand}" Margin="0,6" /><Button Content="{Binding Learning.InputB}" Command="{Binding Learning.ToggleSecondInputCommand}" Margin="8,6" /></StackPanel><TextBlock Text="{Binding Learning.Result}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8" /></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="0,20"><Button Content="← Compuerta anterior" Command="{Binding Learning.PreviousCommand}" /><Button Content="Siguiente compuerta →" Command="{Binding Learning.NextCommand}" Margin="10,3" /></StackPanel></StackPanel>
            <Border Grid.Column="1" Background="#FF101E31" Padding="22" CornerRadius="10"><StackPanel><TextBlock Text="TABLA DE VERDAD" FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" /><ItemsControl ItemsSource="{Binding Learning.TruthTable}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="10,6" CornerRadius="4"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#FF1D4B56" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" /></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><TextBlock Text="{Binding Inputs}" /><TextBlock Text="{Binding Output}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="1" Visibility="{Binding IsChallengesMode, Converter={StaticResource BoolToVisibility}}" Margin="36,24"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer><StackPanel><TextBlock Text="DESAFÍOS" FontSize="34" FontWeight="Bold"/><TextBlock Text="Resuelve circuitos, gana estrellas y desbloquea nuevos retos." Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,16"/><ItemsControl ItemsSource="{Binding Challenges.Catalog.Challenges}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FF142840" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,5"><DockPanel><Button DockPanel.Dock="Right" Content="Jugar" Command="{Binding DataContext.Challenges.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Abrir desafío"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Difficulty}" FontSize="11" Foreground="{StaticResource AccentBrush}"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
            <Border Grid.Column="1" Background="#FF101E31" CornerRadius="10" Padding="20" Margin="20,0,0,0"><StackPanel><TextBlock Text="PROGRESO" Foreground="{StaticResource MutedInkBrush}" FontWeight="Bold"/><TextBlock Text="{Binding Challenges.Progress.Rank}" FontSize="22" FontWeight="Bold" Margin="0,8"/><ProgressBar Value="{Binding Challenges.Progress.Xp}" Maximum="1000" Height="8" Margin="0,4"/><TextBlock Text="{Binding Challenges.Progress.Xp, StringFormat={}XP: {0}}"/><TextBlock Text="{Binding Challenges.Progress.TotalStars, StringFormat={}Estrellas: {0}}" Margin="0,5"/><TextBlock Text="{Binding Challenges.Active.Title}" FontSize="18" FontWeight="Bold" Margin="0,24,0,4"/><TextBlock Text="{Binding Challenges.ResultMessage}" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"/><Button Content="COMPROBAR CIRCUITO" Style="{StaticResource PrimaryButton}" Command="{Binding Challenges.CheckCommand}" Margin="0,16,0,3"/><Button Content="REINICIAR DESAFÍO" Command="{Binding Challenges.ResetCommand}"/><TextBlock Text="Los resultados se guardan localmente." Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,16"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Background="#FF0D1929" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel><TextBlock Text="{Binding Editor.StatusMessage}" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Editor.ZoomPercentage}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" /></DockPanel></Border>
    </Grid>
</Window>
